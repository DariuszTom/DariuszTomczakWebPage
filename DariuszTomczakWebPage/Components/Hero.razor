@inject IJSRuntime JS
@inject IOptions<LinksOptions> Links

<section id="top" class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
        <div class="hero__text">
            <p class="hero__eyebrow">@(Profile?.Person.Title ?? "Senior Full Stack Developer")</p>
            <h1 id="hero-title" tabindex="-1">@(Profile?.Person.Name ?? "Dariusz Tomczak")</h1>
            <span class="hero__bar" aria-hidden="true"></span>
            @if (Profile is not null)
            {
                <p class="hero__summary">@(Profile.Person.Tagline ?? Profile.Person.Summary)</p>
            }
            <div class="hero__actions no-print">
                <a class="btn btn--accent" href="#projects">
                    View my work
                    <Icon Name="arrow" Size="18" />
                </a>
                @if (CvUrl is not null)
                {
                    <a class="btn btn--outline" href="@CvUrl" target="_blank" rel="noopener noreferrer"
                       aria-label="Download CV, opens in a new tab">
                        <Icon Name="download" Size="18" />
                        Download CV
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn--outline" @onclick="PrintAsync">
                        <Icon Name="download" Size="18" />
                        Download CV
                    </button>
                }
            </div>
            @if (Profile is not null)
            {
                <ul class="hero__meta">
                    @if (!string.IsNullOrWhiteSpace(Profile.Person.Location))
                    {
                        <li><Icon Name="pin" Size="18" /><span>@Profile.Person.Location</span></li>
                    }
                    @if (ProfileFormat.Current(Profile) is { } current)
                    {
                        <li><Icon Name="briefcase" Size="18" /><span>@current.Company</span></li>
                    }
                    @if (LinkedIn is not null)
                    {
                        <li class="no-print">
                            <a class="hero__badge" href="@LinkedIn" target="_blank" rel="noopener noreferrer"
                               aria-label="LinkedIn profile, opens in a new tab">
                                <span class="hero__badge-logo" aria-hidden="true">in</span>
                                <span>View profile</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="hero__code no-print">
            <CodeDebugger />
        </div>
    </div>
    @if (Profile?.Focus is { Count: > 0 } focus)
    {
        <div class="container">
            <ul class="hero__focus">
                @foreach (var area in focus)
                {
                    <li class="focus">
                        <span class="focus__icon"><Icon Name="@(area.Icon ?? "code")" Size="24" /></span>
                        <h3>@area.Title</h3>
                        <p>@area.Description</p>
                    </li>
                }
            </ul>
        </div>
    }
</section>

@code {
    [Parameter] public Profile? Profile { get; set; }

    private string? CvUrl => SafeUrl.Https(Links.Value.Cv);

    private string? LinkedIn => SafeUrl.Https(Links.Value.LinkedIn);

    private async Task PrintAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("site.printPage");
        }
        catch (JSException)
        {
            // Printing is best-effort; nothing to recover.
        }
    }
}
