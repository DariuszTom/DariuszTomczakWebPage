@inject IOptions<LinksOptions> Links

<section id="about" class="section section--alt" aria-labelledby="about-title">
    <div class="container about">
        <aside class="card about__card" aria-label="Profile summary">
            <div class="about__who">
                <span class="about__avatar" aria-hidden="true">@Initials</span>
                <div>
                    <p class="about__name">@Profile.Person.Name</p>
                    <p class="about__title">@Profile.Person.Title</p>
                </div>
            </div>
            <hr class="about__divider" />
            <ul class="about__facts">
                @if (ProfileFormat.Current(Profile) is { } current)
                {
                    <li><Icon Name="briefcase" Size="20" /><span>@current.Company</span></li>
                }
                @if (!string.IsNullOrWhiteSpace(Profile.Person.Location))
                {
                    <li><Icon Name="pin" Size="20" /><span>@Profile.Person.Location</span></li>
                }
                @if (Profile.Languages.Count > 0)
                {
                    <li><Icon Name="languages" Size="20" /><span>@string.Join(", ", Profile.Languages.Select(l => l.Name))</span></li>
                }
                @if (Profile.Person.Stack is { Count: > 0 } stack)
                {
                    <li><Icon Name="code" Size="20" /><span>@string.Join(" · ", stack)</span></li>
                }
            </ul>
            <div class="about__links no-print">
                @if (LinkedIn is not null)
                {
                    <a class="about__link" href="@LinkedIn" target="_blank" rel="noopener noreferrer"
                       aria-label="LinkedIn profile, opens in a new tab">
                        <Icon Name="linkedin" Size="18" />LinkedIn
                    </a>
                }
                @if (GitHub is not null)
                {
                    <a class="about__link" href="@GitHub" target="_blank" rel="noopener noreferrer"
                       aria-label="GitHub profile, opens in a new tab">
                        <Icon Name="github" Size="18" />GitHub
                    </a>
                }
            </div>
        </aside>
        <div class="about__main">
            <SectionHeading Id="about-title" Title="About me" />
            @foreach (var paragraph in Paragraphs)
            {
                <p class="about__text">@paragraph</p>
            }
            @if (Profile.Focus is { Count: > 0 } focus)
            {
                <ul class="about__focus">
                    @foreach (var area in focus)
                    {
                        <li class="focus">
                            <span class="focus__icon"><Icon Name="@(area.Icon ?? "code")" Size="24" /></span>
                            <h3>@area.Title</h3>
                            <p>@area.Description</p>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Profile Profile { get; set; } = null!;

    private string? LinkedIn => SafeUrl.Https(Links.Value.LinkedIn);

    private string? GitHub => SafeUrl.Https(Links.Value.GitHub);

    private IReadOnlyList<string> Paragraphs =>
        Profile.Person.About is { Count: > 0 } about ? about : [Profile.Person.Summary];

    private string Initials => string.Concat(
        Profile.Person.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
