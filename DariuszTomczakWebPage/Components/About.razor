<section id="about" class="section section--alt" aria-labelledby="about-title">
    <div class="container about">
        <div class="about__main">
            <SectionHeading Id="about-title" Title="About me" />
            @foreach (var paragraph in Paragraphs)
            {
                <p class="about__text">@paragraph</p>
            }
            @if (Profile.Focus is { Count: > 0 } focus)
            {
                <ul class="about__focus">
                    @foreach (var area in focus)
                    {
                        <li class="focus">
                            <span class="focus__icon"><Icon Name="@(area.Icon ?? "code")" Size="24" /></span>
                            <h3>@area.Title</h3>
                            <p>@area.Description</p>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Profile Profile { get; set; } = null!;

    private IReadOnlyList<string> Paragraphs =>
        Profile.Person.About is { Count: > 0 } about ? about : [Profile.Person.Summary];
}
