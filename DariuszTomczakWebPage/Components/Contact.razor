@inject IOptions<LinksOptions> Links

<section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container contact">
        <div class="contact__main">
            <SectionHeading Id="contact-title" Title="Contact" />
            <p class="contact__text">
                Want to talk about something on this page, or compare notes on .NET, Blazor or MAUI? Drop me a line.
            </p>
            <ul class="contact__links">
                @if (LinkedIn is not null)
                {
                    <li>
                        <a class="row" href="@LinkedIn" target="_blank" rel="noopener noreferrer">
                            <span class="icon-circle row__icon"><Icon Name="linkedin" Size="20" /></span>
                            <span class="row__text">
                                <span class="row__label">LinkedIn</span>
                                <span class="row__value">@Display(LinkedIn)</span>
                            </span>
                            <span class="visually-hidden">(opens in a new tab)</span>
                        </a>
                    </li>
                }
                @if (GitHub is not null)
                {
                    <li>
                        <a class="row" href="@GitHub" target="_blank" rel="noopener noreferrer">
                            <span class="icon-circle row__icon"><Icon Name="github" Size="20" /></span>
                            <span class="row__text">
                                <span class="row__label">GitHub</span>
                                <span class="row__value">@Display(GitHub)</span>
                            </span>
                            <span class="visually-hidden">(opens in a new tab)</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
        <aside class="card contact__card" aria-label="Location and languages">
            @if (!string.IsNullOrWhiteSpace(Profile.Person.Location))
            {
                <div class="fact">
                    <span class="icon-circle row__icon"><Icon Name="pin" Size="20" /></span>
                    <div class="row__text">
                        <span class="row__label">Based in</span>
                        <span class="row__value">@Profile.Person.Location</span>
                    </div>
                </div>
            }
            @if (Profile.Languages.Count > 0)
            {
                <div class="fact">
                    <span class="icon-circle row__icon"><Icon Name="languages" Size="20" /></span>
                    <div class="row__text">
                        <span class="row__label">Languages</span>
                        <ul class="langs">
                            @foreach (var lang in Profile.Languages)
                            {
                                <li><span class="row__value">@lang.Name</span> <span class="text2">@lang.Level</span></li>
                            }
                        </ul>
                    </div>
                </div>
            }
            <p class="text2 contact__note">Open to conversations about .NET, Blazor, MAUI and AI-assisted development.</p>
        </aside>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Profile Profile { get; set; } = null!;

    private string? LinkedIn => SafeUrl.Https(Links.Value.LinkedIn);

    private string? GitHub => SafeUrl.Https(Links.Value.GitHub);

    private static string Display(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri)
            ? (uri.Host.StartsWith("www.", StringComparison.OrdinalIgnoreCase) ? uri.Host[4..] : uri.Host) + uri.AbsolutePath.TrimEnd('/')
            : url;
}
