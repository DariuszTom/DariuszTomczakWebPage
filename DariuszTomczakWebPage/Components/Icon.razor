@* Line icons used across the site (24x24, stroke = currentColor). *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="@Class">
    @switch (Name)
    {
        case "code":
            <path d="M8 6l-6 6 6 6M16 6l6 6-6 6" />
            break;
        @* Brand logos are filled shapes, so they opt out of the stroke style. *@
        case "github":
            <path fill="currentColor" stroke="none" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            break;
        case "linkedin":
            <path fill="currentColor" stroke="none" transform="translate(-2.4 -2.4) scale(1.2)" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.834 1.635-1.8 3.37-1.8 3.601 0 4.267 2.37 4.267 4.892v4.931zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" />
            break;
        case "moon":
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "arrow":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
            break;
        case "pin":
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
            break;
        case "briefcase":
            <rect x="3" y="7" width="18" height="13" rx="2" />
            <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18" />
            break;
        case "languages":
            <path d="M4 5h8M8 3v2M6 5c0 4 3 7 6 8M10 5c0 4-3 7-6 8" />
            <path d="M13 21l4-9 4 9M14.5 18h5" />
            break;
        case "layers":
            <path d="M12 3l9 5-9 5-9-5 9-5z" />
            <path d="M3 13l9 5 9-5" />
            <path d="M3 17.5l9 5 9-5" />
            break;
        case "upload":
            <path d="M12 3v12M7 8l5-5 5 5M5 21h14" />
            break;
        case "bot":
            <rect x="5" y="8" width="14" height="11" rx="2" />
            <path d="M12 4v4M9 13h.01M15 13h.01M9 16h6" />
            break;
        case "check":
            <path d="M5 12l5 5 9-10" />
            break;
        case "external":
            <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            break;
        case "book":
            <path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5z" />
            <path d="M4 19a2 2 0 0 1 2-2h13" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z" />
            break;
        case "game":
            <rect x="2" y="7" width="20" height="11" rx="5" />
            <path d="M7 11v3M5.5 12.5h3M15 12h.01M18 13.5h.01" />
            break;
        case "phone":
            <rect x="6" y="2" width="12" height="20" rx="2" />
            <path d="M11 18h2" />
            break;
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M3 7l9 6 9-6" />
            break;
        default:
            <circle cx="12" cy="12" r="3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string StrokeWidth { get; set; } = "2";
    [Parameter] public string? Class { get; set; }
}
