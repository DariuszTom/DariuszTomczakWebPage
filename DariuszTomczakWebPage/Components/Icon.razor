@* Line icons used across the site (24x24, stroke = currentColor). *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="@Class">
    @switch (Name)
    {
        case "code":
        case "github":
            <path d="M8 6l-6 6 6 6M16 6l6 6-6 6" />
            break;
        case "linkedin":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <circle cx="9" cy="11" r="2" />
            <path d="M6 16c.6-1.5 1.8-2.2 3-2.2s2.4.7 3 2.2M14 10h4M14 14h3" />
            break;
        case "moon":
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "arrow":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
            break;
        case "pin":
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
            break;
        case "briefcase":
            <rect x="3" y="7" width="18" height="13" rx="2" />
            <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18" />
            break;
        case "languages":
            <path d="M4 5h8M8 3v2M6 5c0 4 3 7 6 8M10 5c0 4-3 7-6 8" />
            <path d="M13 21l4-9 4 9M14.5 18h5" />
            break;
        case "layers":
            <path d="M12 3l9 5-9 5-9-5 9-5z" />
            <path d="M3 13l9 5 9-5" />
            <path d="M3 17.5l9 5 9-5" />
            break;
        case "upload":
            <path d="M12 3v12M7 8l5-5 5 5M5 21h14" />
            break;
        case "bot":
            <rect x="5" y="8" width="14" height="11" rx="2" />
            <path d="M12 4v4M9 13h.01M15 13h.01M9 16h6" />
            break;
        case "check":
            <path d="M5 12l5 5 9-10" />
            break;
        case "external":
            <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            break;
        case "book":
            <path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5z" />
            <path d="M4 19a2 2 0 0 1 2-2h13" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z" />
            break;
        case "game":
            <rect x="2" y="7" width="20" height="11" rx="5" />
            <path d="M7 11v3M5.5 12.5h3M15 12h.01M18 13.5h.01" />
            break;
        case "phone":
            <rect x="6" y="2" width="12" height="20" rx="2" />
            <path d="M11 18h2" />
            break;
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M3 7l9 6 9-6" />
            break;
        default:
            <circle cx="12" cy="12" r="3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string StrokeWidth { get; set; } = "2";
    [Parameter] public string? Class { get; set; }
}
