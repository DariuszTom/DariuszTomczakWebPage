{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "ignorePatterns": [
    "**/bin/**",
    "**/obj/**",
    "**/wwwroot/lib/**",
    "**/Splash/vendor/**",
    "**/*.min.js"
  ],
  "overrides": [
    {
      "files": [ "**/*.lib.module.js" ],
      "parserOptions": { "sourceType": "module" }
    }
  ]
}
